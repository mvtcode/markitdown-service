# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# API Security (Bảo mật Header: X-API-Token / Bearer token. Để trống nếu muốn public)
API_AUTH_TOKEN=your-secret-api-token-here

# Queue & Storage
REDIS_URL=redis://localhost:6379/0
QUEUE_MODE=celery
STORAGE_DIR=./storage_data

# Optional Default LLM (Fallback if not provided in HTTP request headers)
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o

# Webhook configuration
WEBHOOK_TIMEOUT_SECONDS=10.0
WEBHOOK_MAX_RETRIES=4

